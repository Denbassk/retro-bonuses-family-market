async function loadLookups() {
  lookups = { suppliers: {}, supplier_brands: {}, brand_supplier: {} };
  const { data: s, error: e1 } = await sb.from('suppliers').select('id, name');
  if (e1) console.error('loadLookups suppliers error:', e1);
  (s || []).forEach(r => lookups.suppliers[r.id] = r.name);
  const { data: b, error: e2 } = await sb.from('supplier_brands').select('id, name, supplier_id');
  if (e2) console.error('loadLookups brands error:', e2);
  (b || []).forEach(r => { lookups.supplier_brands[r.id] = r.name; lookups.brand_supplier[r.id] = r.supplier_id; });
  console.log(`Lookups loaded: ${Object.keys(lookups.suppliers).length} suppliers, ${Object.keys(lookups.supplier_brands).length} brands`);
}

function renderNav() {
  const nav = document.getElementById('nav');
  let html = Object.entries(TABLES).map(([k, v]) =>
    `<button class="nav-btn ${k === currentTable ? 'active' : ''}" onclick="switchTable('${k}')">${v.label}</button>`
  ).join('');

function onReconSearch(val) {
  searchTerm = val.toLowerCase();
  renderReconciliation();
}

function clearReconSearch() {
  searchTerm = '';
  const input = document.getElementById('search-input');
  if (input) input.value = '';
  renderReconciliation();
}

function onReconFilterChange(val) {
  reconFilter = val;
  renderReconciliation();
}

async function loadReconciliation() {
  const wrap = document.getElementById('table-wrap');
  wrap.innerHTML = '<div class="loading">Завантаження...</div>';

  await loadLookups();

  // Загружаем начисления
  const { data: calcs, error: e1 } = await sb.from('retro_calculations')
    .select('id, supplier_id, period_label, total_retro, status');

  // Загружаем base_type для каждого поставщика
  const { data: rules } = await sb.from('retro_rules')
    .select('supplier_brand_id, retro_base_type')
    .eq('status', 'active');
  const { data: rulebBrands } = await sb.from('supplier_brands')
    .select('id, supplier_id');
  const baseTypeBySupplier = {};
  const brandSupMap = {};
  (rulebBrands || []).forEach(b => brandSupMap[b.id] = b.supplier_id);
  (rules || []).forEach(r => {
    const sid = brandSupMap[r.supplier_brand_id];
    if (sid && r.retro_base_type) baseTypeBySupplier[sid] = r.retro_base_type;
  });
  if (e1) {
    wrap.innerHTML = `<div class="loading" style="color:var(--red)">Помилка: ${e1.message}</div>`;
    return;
  }

  // Загружаем факты оплат
  const { data: facts, error: e2 } = await sb.from('retro_payments_fact')
    .select('id, supplier_id, period_label, amount_paid, payment_date, doc_number, notes');
  if (e2) {
    wrap.innerHTML = `<div class="loading" style="color:var(--red)">Помилка: ${e2.message}</div>`;
    return;
  }

  // Собираем список месяцев (из начислений + фактов)
  const monthsSet = new Set();
  (calcs || []).forEach(c => monthsSet.add(c.period_label));
  (facts || []).forEach(f => monthsSet.add(f.period_label));
  const months = Array.from(monthsSet).sort();

  // Собираем список поставщиков (только тех, у кого есть начисления или факты)
  const supSet = new Set();
  (calcs || []).forEach(c => supSet.add(c.supplier_id));
  (facts || []).forEach(f => supSet.add(f.supplier_id));
  const suppliers = Array.from(supSet)
    .map(id => ({ id, name: lookups.suppliers[id] || '???' }))
    .sort((a, b) => a.name.localeCompare(b.name, 'uk'));

  reconData = { calcs: calcs || [], facts: facts || [], months, suppliers, baseTypeBySupplier };
  renderReconciliation();
}

function baseTypeIcon(baseType) {
  if (baseType === 'payments') return '<span title="Ретро від оплат" style="cursor:help">💳</span>';
  if (baseType === 'per_portion_sold') return '<span title="Ретро за порцію" style="cursor:help">☕</span>';
  return '<span title="Ретро від приходів" style="cursor:help">🧾</span>';
}


function renderReconciliation() {
  const wrap = document.getElementById('table-wrap');
  const { calcs, facts, months, suppliers } = reconData;

  if (!months.length || !suppliers.length) {
    wrap.innerHTML = '<div class="loading">Нет данных. Сначала запустите расчёт ретро (calculate_retro.py).</div>';
    return;
  }

  // Индексируем по (supplier_id + period_label)
  const calcMap = {}; // key → total_retro
  const factMap = {}; // key → {amount_paid, id, payment_date, doc_number, notes}
  calcs.forEach(c => { calcMap[c.supplier_id + '|' + c.period_label] = { total: parseFloat(c.total_retro) || 0, id: c.id, status: c.status }; });
  facts.forEach(f => {
    factMap[f.supplier_id + '|' + f.period_label] = {
      id: f.id,
      amount: parseFloat(f.amount_paid) || 0,
      date: f.payment_date,
      doc: f.doc_number,
      notes: f.notes
    };
  });

  // Фильтрация поставщиков
  let filtered = suppliers.filter(s => {
    if (searchTerm && !s.name.toLowerCase().includes(searchTerm)) return false;

    if (reconFilter === 'all') return true;

    // Считаем суммы по поставщику за все месяцы
    let totalCharged = 0, totalPaid = 0;
    months.forEach(m => {
      totalCharged += (calcMap[s.id + '|' + m] || {}).total || 0;
      totalPaid += (factMap[s.id + '|' + m] || {}).amount || 0;
    });

    if (reconFilter === 'unpaid') return totalCharged > 0 && totalPaid === 0;
    if (reconFilter === 'with_diff') {
      if (totalCharged === 0) return false;
      const diffPct = Math.abs(totalPaid - totalCharged) / totalCharged * 100;
      return diffPct > 2;
    }
    if (reconFilter === 'zero_charged') return totalCharged === 0;
    return true;
  });

  document.getElementById('count-badge').textContent = `${filtered.length} поставщиков, ${months.length} месяцев`;

  // Рендер таблицы
  let html = '<table><thead><tr>';
  html += '<th style="width:40px;text-align:center">№</th>';
  html += '<th style="min-width:220px;position:sticky;left:0;background:var(--surface2);z-index:11">Поставщик</th>';
  months.forEach(m => {
    html += `<th style="min-width:180px;text-align:center" colspan="1">${m}</th>`;
  });
  html += '<th style="min-width:160px;text-align:center;background:var(--surface2)">ИТОГО</th>';
  html += '</tr></thead><tbody>';

  // Итоги по столбцам
  const colTotals = {};
  months.forEach(m => colTotals[m] = { charged: 0, paid: 0 });
  let grandCharged = 0, grandPaid = 0;

  filtered.forEach((s, idx) => {
    let rowCharged = 0, rowPaid = 0;
    let cellsHtml = '';
    months.forEach(m => {
      const calcEntry = calcMap[s.id + '|' + m] || {};
      const charged = calcEntry.total || 0;
      const factRow = factMap[s.id + '|' + m];
      const paid = factRow ? factRow.amount : 0;
      rowCharged += charged;
      rowPaid += paid;
      colTotals[m].charged += charged;
      colTotals[m].paid += paid;
      cellsHtml += renderReconCell(s.id, m, charged, factRow, calcEntry);
    });
    grandCharged += rowCharged;
    grandPaid += rowPaid;

    const rowStatus = getReconStatus(rowCharged, rowPaid);
    html += `<tr>
      <td style="text-align:center;color:var(--text2)">${idx + 1}</td>
      <td style="position:sticky;left:0;background:var(--surface);font-weight:500">
        ${baseTypeIcon(reconData.baseTypeBySupplier[s.id])} ${escHtml(s.name)}
      </td>
      ${cellsHtml}
      <td style="text-align:right;background:var(--surface2);font-weight:600">
        <div style="color:${rowStatus.color}">${fmt(rowPaid)} / ${fmt(rowCharged)}</div>
        <div style="font-size:11px;color:var(--text2)">${rowStatus.label}</div>
      </td>
    </tr>`;
  });

  // Строка итогов
  html += `<tr style="background:var(--surface2);font-weight:600;border-top:2px solid var(--accent)">
    <td></td>
    <td style="position:sticky;left:0;background:var(--surface2)">ИТОГО</td>`;
  months.forEach(m => {
    const t = colTotals[m];
    const st = getReconStatus(t.charged, t.paid);
    html += `<td style="text-align:right;padding:8px 10px">
      <div style="color:${st.color}">${fmt(t.paid)}</div>
      <div style="font-size:11px;color:var(--text2)">из ${fmt(t.charged)}</div>
    </td>`;
  });
  const totalStatus = getReconStatus(grandCharged, grandPaid);
  html += `<td style="text-align:right;padding:8px 10px;background:var(--surface)">
    <div style="color:${totalStatus.color};font-size:14px">${fmt(grandPaid)}</div>
    <div style="font-size:11px;color:var(--text2)">из ${fmt(grandCharged)}</div>
  </td>`;
  html += '</tr>';

  html += '</tbody></table>';
  wrap.innerHTML = html;
}

function renderReconCell(supId, period, charged, factRow, calcEntry) {
  const paid = factRow ? factRow.amount : 0;
  const status = getReconStatus(charged, paid);
  const isApproved = calcEntry && calcEntry.status === 'approved';
  const isPaid = calcEntry && calcEntry.status === 'paid';
  const isLocked = isApproved || isPaid;
  const calcId = calcEntry && calcEntry.id;

  const tooltip = factRow ?
    `Оплачено ${fmt(paid)}\nДата: ${factRow.date || '—'}\nДокумент: ${factRow.doc || '—'}\nЗаметки: ${factRow.notes || '—'}` :
    (charged > 0 ? `Не оплачено\nНачислено: ${fmt(charged)}` : 'Нет начислений');

  const lockBadge = isLocked
    ? `<div style="font-size:10px;color:${isPaid ? 'var(--green)' : '#a78bfa'};margin-top:2px">${isPaid ? '💚 оплачено' : '🔒 затверджено'}</div>`
    : '';

  const approveBtn = calcId && !isLocked && charged > 0
    ? `<button onclick="event.stopPropagation();approveCalc('${calcId}','${supId}','${period}')"
         title="Затвердити — захистить від перезапису"
         style="margin-top:4px;font-size:10px;padding:2px 6px;border:1px solid #a78bfa;background:transparent;color:#a78bfa;border-radius:4px;cursor:pointer">🔒 lock</button>`
    : '';

  const unlockBtn = isApproved && calcId
    ? `<button onclick="event.stopPropagation();unlockCalc('${calcId}','${supId}','${period}')"
         title="Зняти захист"
         style="margin-top:4px;font-size:10px;padding:2px 6px;border:1px solid var(--text2);background:transparent;color:var(--text2);border-radius:4px;cursor:pointer">🔓</button>`
    : '';

  return `<td class="${isLocked ? '' : 'editable'}"
            style="text-align:right;padding:6px 10px;background:${isLocked ? 'rgba(167,139,250,0.05)' : status.bg}"
            ondblclick="${isLocked ? '' : `openReconCellModal('${supId}','${period}')`}"
            title="${escHtml(tooltip)}">
    <div style="color:${status.color};font-weight:500">${fmt(paid)}</div>
    <div style="font-size:11px;color:var(--text2)">з ${fmt(charged)} ${status.icon}</div>
    ${lockBadge}
    ${approveBtn}
    ${unlockBtn}
  </td>`;
}

function getReconStatus(charged, paid) {
  if (charged === 0 && paid === 0) {
    return { color: 'var(--text2)', bg: 'transparent', icon: '⬜', label: '—' };
  }
  if (charged === 0 && paid > 0) {
    return { color: '#a78bfa', bg: 'rgba(167,139,250,0.08)', icon: '🟣', label: 'Без начисления' };
  }
  const pct = paid / charged * 100;
  if (paid === 0) return { color: 'var(--red)', bg: 'rgba(248,113,113,0.08)', icon: '🔴', label: 'Не оплачено' };
  if (pct < 50) return { color: 'var(--red)', bg: 'rgba(248,113,113,0.08)', icon: '🔴', label: `${pct.toFixed(0)}%` };
  if (pct < 98) return { color: 'var(--orange)', bg: 'rgba(251,191,36,0.08)', icon: '🟡', label: `${pct.toFixed(0)}%` };
  if (pct <= 102) return { color: 'var(--green)', bg: 'rgba(52,211,153,0.08)', icon: '🟢', label: 'OK' };
  return { color: '#a78bfa', bg: 'rgba(167,139,250,0.08)', icon: '🟣', label: `+${(pct-100).toFixed(0)}%` };
}

async function approveCalc(calcId, supId, period) {
  const sup = reconData.suppliers.find(s => s.id === supId);
  const supName = sup ? sup.name : supId;
  if (!confirm(`Затвердити розрахунок:\n${supName} — ${period}?\n\nПісля затвердження автоматичний перерахунок НЕ буде перезаписувати цей місяць.`)) return;
  const { error } = await sb.from('retro_calculations').update({ status: 'approved' }).eq('id', calcId);
  if (error) { toast(`Помилка: ${error.message}`, true); return; }
  toast(`🔒 ${supName} ${period} — затверджено`);
  await loadReconciliation();
}

async function unlockCalc(calcId, supId, period) {
  const sup = reconData.suppliers.find(s => s.id === supId);
  const supName = sup ? sup.name : supId;
  if (!confirm(`Зняти захист:\n${supName} — ${period}?\n\nПісля зняття автоматичний перерахунок зможе перезаписати цей місяць.`)) return;
  const { error } = await sb.from('retro_calculations').update({ status: 'completed' }).eq('id', calcId);
  if (error) { toast(`Помилка: ${error.message}`, true); return; }
  toast(`🔓 ${supName} ${period} — захист знято`);
  await loadReconciliation();
}

function fmt(n) {
  if (!n) return '0';
  return n.toLocaleString('uk-UA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

async function openReconCellModal(supId, period) {
  const calcMap = {};
  reconData.calcs.forEach(c => { calcMap[c.supplier_id + '|' + c.period_label] = { total: parseFloat(c.total_retro) || 0, id: c.id, status: c.status }; });
  const calcEntry = calcMap[supId + '|' + period] || {};
  const charged = calcEntry.total || 0;
  const calcId = calcEntry.id || null;

  const factRow = reconData.facts.find(f => f.supplier_id === supId && f.period_label === period);
  const sup = reconData.suppliers.find(s => s.id === supId);
  const supName = sup ? sup.name : '???';

  let extrasHtml = '';
  if (calcId) {
    const { data: extras } = await sb.from('retro_calculation_details')
      .select('id, retro_amount, notes')
      .eq('calculation_id', calcId)
      .eq('applied_percent', 0)
      .neq('retro_amount', 0)
      .is('retro_rule_id', null);

    if (extras && extras.length) {
      extras.forEach(e => {
        extrasHtml += `<div style="display:flex;justify-content:space-between;align-items:center;
          padding:4px 8px;background:rgba(52,211,153,0.08);border-radius:4px;margin-bottom:3px;font-size:12px">
          <span style="color:var(--text2)">${escHtml(e.notes || '—')}</span>
          <div style="display:flex;align-items:center;gap:8px">
            <span style="color:var(--green);font-weight:600">+${fmt(e.retro_amount)} ₴</span>
            <button onclick="deleteExtraPayment('${e.id}', ${e.retro_amount}, '${calcId}')"
              style="background:none;border:none;color:var(--red);cursor:pointer;font-size:14px;padding:0 2px;line-height:1"
              title="Видалити">✕</button>
          </div>
        </div>`;
      });
    }
  }

  const html = `
    <h2>💰 Факт оплаты ретро</h2>
    <div style="padding:12px;background:var(--surface2);border-radius:6px;margin-bottom:16px">
      <div style="font-size:14px;font-weight:600;margin-bottom:6px">${escHtml(supName)}</div>
      <div style="color:var(--text2);font-size:13px">Период: <b style="color:var(--text)">${period}</b></div>
      <div style="color:var(--text2);font-size:13px">Начислено: <b style="color:var(--accent)">${fmt(charged)} ₴</b></div>
    </div>

    <label>Оплачено, грн *</label>
    <input id="f_amount_paid" type="number" step="0.01" value="${factRow ? factRow.amount_paid : ''}" placeholder="0.00">

    <label>Дата оплаты</label>
    <input id="f_payment_date" type="date" value="${factRow && factRow.payment_date ? factRow.payment_date : ''}">

    <label>№ документа</label>
    <input id="f_doc_number" value="${escHtml(factRow && factRow.doc_number || '')}" placeholder="напр. Акт №123 от 15.02.2026">

    <label>Заметки</label>
    <textarea id="f_notes">${escHtml(factRow && factRow.notes || '')}</textarea>

    ${calcId ? `
    <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border)">
      <div style="font-size:13px;font-weight:600;margin-bottom:8px;color:var(--text)">➕ Доп. виплата (куби, акції)</div>
      ${extrasHtml}
      <div style="display:flex;gap:8px;margin-top:6px">
        <input id="f_extra_amount" type="number" step="0.01" placeholder="Сума, грн" style="width:140px">
        <input id="f_extra_notes" placeholder="Примітка (напр. куби)" style="flex:1">
        <button class="btn btn-ghost" onclick="addExtraPayment('${calcId}')"
          style="white-space:nowrap;border-color:var(--green);color:var(--green)">+ Додати</button>
      </div>
    </div>` : ''}

    <div class="actions">
      ${factRow ? `<button class="btn btn-red" onclick="deleteReconFact('${factRow.id}')">Удалить</button>` : ''}
      <button class="btn btn-ghost" onclick="closeModal()">Отмена</button>
      <button class="btn btn-green" onclick="saveReconFact('${supId}','${period}',${factRow ? "'"+factRow.id+"'" : 'null'})">Сохранить</button>
    </div>
  `;

  document.getElementById('modal').innerHTML = html;
  document.getElementById('modal-overlay').classList.add('show');
  setTimeout(() => document.getElementById('f_amount_paid').focus(), 100);
}

async function addExtraPayment(calcId) {
  const amount = parseFloat(document.getElementById('f_extra_amount').value);
  const notes = document.getElementById('f_extra_notes').value || '';

  if (isNaN(amount) || amount <= 0) { toast('Введіть коректну суму', true); return; }
  if (!notes.trim()) { toast('Введіть примітку', true); return; }

  // Берём supplier_brand_id из существующих деталей
  const { data: existingDetail } = await sb.from('retro_calculation_details')
    .select('supplier_brand_id').eq('calculation_id', calcId).limit(1);
  const brandId = existingDetail && existingDetail.length ? existingDetail[0].supplier_brand_id : null;

  const { error: e1 } = await sb.from('retro_calculation_details').insert({
    calculation_id: calcId,
    supplier_brand_id: brandId,
    applied_percent: 0,
    amount_purchased: 0,
    amount_returned: 0,
    amount_net: 0,
    retro_amount: amount,
    retro_amount_vat: amount,
    bonus_form: 'price_correction',
    notes: notes,
  });
  if (e1) { toast('Помилка: ' + e1.message, true); return; }

  // Обновляем total_retro
  const { data: calc } = await sb.from('retro_calculations')
    .select('total_retro').eq('id', calcId).single();
  const newTotal = (parseFloat(calc.total_retro) || 0) + amount;
  await sb.from('retro_calculations').update({ total_retro: newTotal }).eq('id', calcId);

  toast('✅ Доп. виплату додано');
  
  // Перезагружаем данные и переоткрываем модальное окно
  await loadReconciliation();
  
  // Находим supId и period из calcId
  const calcEntry = reconData.calcs.find(c => c.id === calcId);
  if (calcEntry) {
    openReconCellModal(calcEntry.supplier_id, calcEntry.period_label);
  }
}

async function deleteExtraPayment(detailId, amount, calcId) {
  if (!confirm('Видалити доп. виплату?')) return;

  const { error } = await sb.from('retro_calculation_details').delete().eq('id', detailId);
  if (error) { toast('Помилка: ' + error.message, true); return; }

  // Зменшуємо total_retro
  const { data: calc } = await sb.from('retro_calculations')
    .select('total_retro').eq('id', calcId).single();
  const newTotal = Math.max(0, (parseFloat(calc.total_retro) || 0) - parseFloat(amount));
  await sb.from('retro_calculations').update({ total_retro: Math.round(newTotal * 100) / 100 }).eq('id', calcId);

  toast('✅ Доп. виплату видалено');
  await loadReconciliation();
  const calcEntry = reconData.calcs.find(c => c.id === calcId);
  if (calcEntry) openReconCellModal(calcEntry.supplier_id, calcEntry.period_label);
}

async function saveReconFact(supId, period, factId) {
  const amount = parseFloat(document.getElementById('f_amount_paid').value);
  if (isNaN(amount) || amount < 0) {
    toast('Введите корректную сумму', true);
    return;
  }
  const payload = {
    supplier_id: supId,
    period_label: period,
    amount_paid: amount,
    payment_date: document.getElementById('f_payment_date').value || null,
    doc_number: document.getElementById('f_doc_number').value || null,
    notes: document.getElementById('f_notes').value || null,
    updated_at: new Date().toISOString(),
  };

  let result;
  if (factId && factId !== 'null') {
    result = await sb.from('retro_payments_fact').update(payload).eq('id', factId);
  } else {
    result = await sb.from('retro_payments_fact').upsert(payload, { onConflict: 'supplier_id,period_label' });
  }
  if (result.error) {
    toast('Помилка: ' + result.error.message, true);
    return;
  }
  toast('Збережено');
  closeModal();
  await loadReconciliation();
}

async function deleteReconFact(factId) {
  if (!confirm('Удалить запись об оплате?')) return;
  const { error } = await sb.from('retro_payments_fact').delete().eq('id', factId);
  if (error) {
    toast('Помилка: ' + error.message, true);
    return;
  }
  toast('Видалено');
  closeModal();
  await loadReconciliation();
}

async function requireLogin() {
  const { data: { session } } = await sb.auth.getSession();
  if (session) { init(); return; }
  document.getElementById('nav').innerHTML = '';
  document.getElementById('toolbar').innerHTML = '';
  document.getElementById('info-box').innerHTML = '';
  document.getElementById('table-wrap').innerHTML = `
    <div style="max-width:340px;margin:80px auto;padding:24px;background:var(--surface);
                border:1px solid var(--border);border-radius:12px">
      <h2 style="font-size:16px;margin-bottom:16px">Вход в панель</h2>
      <label style="display:block;font-size:12px;color:var(--text2);margin-bottom:4px">Email</label>
      <input id="login_email" style="width:100%;padding:8px 10px;border:1px solid var(--border);
             background:var(--surface2);color:var(--text);border-radius:6px;margin-bottom:10px">
      <label style="display:block;font-size:12px;color:var(--text2);margin-bottom:4px">Пароль</label>
      <input id="login_pass" type="password" onkeydown="if(event.key==='Enter')doLogin()"
             style="width:100%;padding:8px 10px;border:1px solid var(--border);
             background:var(--surface2);color:var(--text);border-radius:6px;margin-bottom:16px">
      <button class="btn btn-primary" style="width:100%" onclick="doLogin()">Войти</button>
    </div>`;
}

async function doLogin() {
  const email = document.getElementById('login_email').value.trim();
  const password = document.getElementById('login_pass').value;
  const { error } = await sb.auth.signInWithPassword({ email, password });
  if (error) { toast('Ошибка входа: ' + error.message, true); return; }
  location.reload();
}

requireLogin();
</script>

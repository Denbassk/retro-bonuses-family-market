async function loadTable() {
  const wrap = document.getElementById('table-wrap');
  wrap.innerHTML = '<div class="loading">Завантаження...</div>';
  const cfg = TABLES[currentTable];
  const { data, error } = await sb.from(currentTable).select('*').order(cfg.order || 'created_at', { ascending: true });
  if (error) { wrap.innerHTML = `<div class="loading" style="color:var(--red)">Помилка: ${error.message}</div>`; return; }
  allData[currentTable] = data || [];
  renderTable();
}

function renderTable() {
  const cfg = TABLES[currentTable];
  const data = filterData(allData[currentTable] || []);
  document.getElementById('count-badge').textContent = `${data.length} записей`;

  if (sortCol) {
    data.sort((a, b) => {
      let va = getCellValue(a, sortCol, cfg), vb = getCellValue(b, sortCol, cfg);
      if (va == null) va = ''; if (vb == null) vb = '';
      let cmp = String(va).localeCompare(String(vb), 'uk', { numeric: true });
      return sortDir === 'desc' ? -cmp : cmp;
    });
  }

  const wrap = document.getElementById('table-wrap');
  let html = '<table><thead><tr>';
  if (cfg.showRowNum) html += '<th style="width:40px;text-align:center">№</th>';
  cfg.columns.forEach(col => {
    const arrow = sortCol === col.key ? (sortDir === 'asc' ? '▲' : '▼') : '';
    html += `<th style="${col.width ? 'min-width:'+col.width : ''}" onclick="toggleSort('${col.key}')">${col.label}<span class="sort-arrow">${arrow}</span></th>`;
  });
  html += '<th style="width:80px">Действия</th></tr></thead><tbody>';

  data.forEach((row, idx) => {
    html += '<tr>';
    if (cfg.showRowNum) html += `<td style="text-align:center;color:var(--text2)">${idx + 1}</td>`;
    cfg.columns.forEach(col => {
      const val = getCellValue(row, col.key, cfg);
      let display = formatCell(val, col);
      const cls = col.editable ? ' class="editable" ondblclick="openEditModal(\''+row.id+'\')"' : '';
      html += `<td${cls}>${display}</td>`;
    });
    html += `<td>
      <button class="btn btn-ghost" style="padding:3px 8px;font-size:12px" onclick="openEditModal('${row.id}')">✎</button>
      <button class="btn btn-ghost" style="padding:3px 8px;font-size:12px;color:var(--red)" onclick="deleteRow('${row.id}')">✕</button>
    </td>`;
    html += '</tr>';
  });

  html += '</tbody></table>';
  wrap.innerHTML = html;
}

function getCellValue(row, key, cfg) {
  if (key === '_supplier_name') {
    if (row.supplier_id) return lookups.suppliers[row.supplier_id] || '—';
    if (row.supplier_brand_id) {
      const sid = lookups.brand_supplier && lookups.brand_supplier[row.supplier_brand_id];
      return sid ? (lookups.suppliers[sid] || '—') : '—';
    }
    return '—';
  }
  if (key === '_brand_name') {
    if (row.supplier_brand_id) return lookups.supplier_brands[row.supplier_brand_id] || '—';
    return '—';
  }
  return row[key];
}

function formatCell(val, col) {
  if (val === null || val === undefined) return '<span style="color:var(--text2)">—</span>';
  if (col.type === 'bool') return val ? '<span class="tag tag-green">Да</span>' : '<span class="tag tag-red">Нет</span>';
  if (col.type === 'sku_count') {
    if (Array.isArray(val)) return `<span class="tag tag-blue">${val.length} шт</span>`;
    if (typeof val === 'string' && val.startsWith('[')) { try { return `<span class="tag tag-blue">${JSON.parse(val).length} шт</span>`; } catch(e) {} }
    return '—';
  }
  if (col.type === 'alias_type_tag') {
    if (val === 'branded')   return '<span class="tag tag-green">Branded</span>';
    if (val === 'remainder') return '<span class="tag tag-orange">Remainder</span>';
    if (val === 'excluded')  return '<span class="tag tag-red">Excluded</span>';
    return '<span class="tag tag-blue">' + (val || '—') + '</span>';
  }
  if (col.key === 'bonus_form') {
    if (val === 'marketing_service') return '<span class="tag tag-orange">Маркетинг (НДС)</span>';
    return '<span class="tag tag-blue">Ф2 (нал)</span>';
  }
  if (col.key === 'retro_base_type') {
    const m = { shipment_minus_return: 'Приход−возврат', payments: 'Оплаты', per_portion_sold: 'За порцію' };
    return m[val] || val;
  }
  if (col.key === 'status') {
    const colors = { draft: 'tag-blue', active: 'tag-green', archived: 'tag-red', in_progress: 'tag-orange', completed: 'tag-green', approved: 'tag-green', paid: 'tag-green', cancelled: 'tag-red' };
    return `<span class="tag ${colors[val] || ''}">${val}</span>`;
  }
  if (col.key === 'retro_min' || col.key === 'retro_max') return val + '%';
  return escHtml(String(val));
}

function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function filterData(data) {
  if (!searchTerm) return [...data];
  return data.filter(row => {
    const cfg = TABLES[currentTable];
    return cfg.columns.some(col => {
      const v = getCellValue(row, col.key, cfg);
      return v != null && String(v).toLowerCase().includes(searchTerm);
    });
  });
}

function toggleSort(col) {
  if (sortCol === col) { sortDir = sortDir === 'asc' ? 'desc' : 'asc'; }
  else { sortCol = col; sortDir = 'asc'; }
  renderTable();
}

async function openEditModal(id) {
  await loadLookups();
  const cfg = TABLES[currentTable];
  const row = (allData[currentTable] || []).find(r => r.id === id);
  if (!row) return;
  renderModal('Редагування', cfg.editFields, row, async (vals) => {
    const clean = cleanVals(vals, cfg);
    const { error } = await sb.from(currentTable).update(clean).eq('id', id);
    if (error) { toast('Помилка: ' + error.message, true); return; }
    toast('Збережено');
    closeModal();
    if (currentTable === 'suppliers' || currentTable === 'supplier_brands') await loadLookups();
    await loadTable();
  });
}

async function openAddModal() {
  await loadLookups();
  const cfg = TABLES[currentTable];
  renderModal('Додати запис', cfg.editFields, {}, async (vals) => {
    const clean = cleanVals(vals, cfg);
    const { error } = await sb.from(currentTable).insert(clean);
    if (error) { toast('Помилка: ' + error.message, true); return; }
    toast('Додано');
    closeModal();
    if (currentTable === 'suppliers' || currentTable === 'supplier_brands') await loadLookups();
    await loadTable();
  });
}


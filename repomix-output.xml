function onAliasTypeChange(type) {
  const hidden = document.getElementById('f_alias_type');
  if (hidden) hidden.value = type;
  const wrap = document.getElementById('brand_wrap');
  const brandSelect = document.getElementById('f_supplier_brand_id');
  if (wrap) {
    if (type === 'branded') {
      wrap.style.display = 'block';
    } else {
      wrap.style.display = 'none';
      if (brandSelect) brandSelect.value = '';
    }
  }
}

function filterBrandDropdown() {
  const suppSelect = document.getElementById('f_supplier_id');
  const brandSelect = document.getElementById('f_supplier_brand_id');
  if (!suppSelect || !brandSelect) return;
  const suppId = suppSelect.value;
  const options = brandSelect.querySelectorAll('option[data-supplier]');
  brandSelect.value = '';
  options.forEach(opt => {
    if (!suppId || opt.dataset.supplier === suppId) {
      opt.hidden = false;
      opt.disabled = false;
    } else {
      opt.hidden = true;
      opt.disabled = true;
    }
  });
}

function saveModal() { if (window._modalSave) window._modalSave(); }
function closeModal() { document.getElementById('modal-overlay').classList.remove('show'); }

document.getElementById('modal-overlay').addEventListener('click', e => {
  if (e.target === document.getElementById('modal-overlay')) closeModal();
});

function cleanVals(vals, cfg) {
  const clean = {};
  Object.entries(vals).forEach(([k, v]) => {
    if (k === 'is_retro_active') { clean[k] = v === 'true'; return; }
    if (k === 'sku_barcodes' || k === 'excluded_sku_barcodes') {
      const lines = String(v).split('\n').map(l => l.trim()).filter(Boolean);
      clean[k] = lines.length ? lines : null;
      return;
    }
if (k === 'retro_min' || k === 'retro_max' || k === 'min_purchase_threshold' || k === 'price_per_portion' || k === 'amount') {
  clean[k] = v ? parseFloat(v) : null;
  return;
}
    if (k === 'cups_per_kg') {
      clean[k] = v ? parseInt(v, 10) : null;
      return;
    }
    if ((k === 'supplier_id' || k === 'supplier_brand_id') && !v) { clean[k] = null; return; }
    if ((k === 'valid_to' || k === 'valid_from') && !v) { clean[k] = null; return; }
    if (k === 'alias_type') { clean[k] = v || 'remainder'; return; }
    clean[k] = v || null;
  });
  return clean;
}

